{
  "name": "@de-otio/maildummy",
  "version": "1.0.1",
  "description": "SES Email Testing Infrastructure",
  "main": "lib/maildummy.js",
  "types": "lib/maildummy.d.ts",
  "exports": {
    ".": {
      "types": "./lib/maildummy.d.ts",
      "default": "./lib/maildummy.js"
    },
    "./scripts/get-magic-link-from-s3.js": "./scripts/get-magic-link-from-s3.js",
    "./scripts/get-magic-link-from-s3": "./scripts/get-magic-link-from-s3.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "maildummy-link": "bin/maildummy-link.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/get-magic-link-from-s3.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "get-magic-link": "node scripts/get-magic-link-from-s3.js",
    "test": "jest --maxWorkers=2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  },
  "keywords": [
    "aws",
    "ses",
    "email",
    "testing",
    "terraform",
    "e2e"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "he": "^1.2.0",
    "mailparser": "^3.0.0"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
